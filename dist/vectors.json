            "year": "19",
            "wilaya": 16
          }
        },
        {
          "id": "no-separators",
          "input": {
            "plate": "1234511916",
            "date": "2026-10-28"
          },
          "expected": {
            "serial": "12345",
            "category": 1,
            "year": "19",
            "wilaya": 16
          }
        },
        {
          "id": "motorcycle",
          "input": {
            "plate": "15843-919-16",
            "date": "2026-10-28"
          },
          "expected": {
            "serial": "15843",

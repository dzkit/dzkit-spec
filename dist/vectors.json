    {
      "operation": "plate.parse",
      "description": "Parse a standard licence plate as of a given date.",
      "rule": "vehicles.plates",
      "inputs": {
        "plate": "plate as typed",
        "date": "date of the check (ISO), because codes 59–69 start on 2027-01-01"
      },
      "outputs": {
        "serial": "serial as written",
        "category": "vehicle category 1–9",
        "year": "two-digit year as written",
        "wilaya": "wilaya code"
      },
      "cases": [
        {
          "id": "blida-2026",
          "input": {
            "plate": "02639-126-09",
            "date": "2026-10-28"
          },
          "expected": {
            "serial": "02639",
            "category": 1,
            "year": "26",
            "wilaya": 9
          },
          "source": "wikipedia-plates"
        },
        {
          "id": "bouira-2025",
          "input": {
            "plate": "76739-125-10",
            "date": "2026-10-28"
          },
          "expected": {
            "serial": "76739",
            "category": 1,
            "year": "25",
            "wilaya": 10
          },
          "source": "wikipedia-plates"
        },
        {
          "id": "spaces",
          "input": {
            "plate": "12345 119 16",
            "date": "2026-10-28"
          },
          "expected": {
            "serial": "12345",

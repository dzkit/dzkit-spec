        "allocated": true
      }
    },
    {
      "id": "plus-213-zero-in-parentheses",
      "input": {
        "number": "+213 (0) 661 23 45 67"
      },
      "expected": {
        "type": "mobile",
        "national": "0661234567",
        "e164": "+213661234567",
        "operator": "Mobilis",
        "allocated": true
      }
    },
    {
      "id": "surrounding-spaces",
      "input": {
        "number": "  0551 23 45 67  "
      },
      "expected": {
        "type": "mobile",
        "national": "0551234567",
        "e164": "+213551234567",
        "operator": "Ooredoo",
        "allocated": true
      }
    },
    {
      "id": "landline-international",
      "input": {
        "number": "+213 21 23 45 67"
      },
      "expected": {
        "type": "landline",
        "national": "021234567",
        "e164": "+21321234567",
        "area_code": "21"
      }
    },
    {
      "id": "landline-annaba",
      "input": {
        "number": "038 12 34 56"
      },
      "expected": {
        "type": "landline",

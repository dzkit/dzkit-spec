{
  "operation": "salary.net-to-gross",
  "description": "Smallest gross monthly salary, to the centime, whose net reaches a target.",
  "contract": "OPERATIONS.md, salary.net-to-gross",
  "inputs": {
    "net": "target net salary in DA",
    "regime": "salaried, retired or disabled",
    "date": "date the salary relates to (ISO)"
  },
  "outputs": {
    "gross": "smallest gross in whole centimes whose net is at least the target",
    "cnas_employee": "as salary.gross-to-net",
    "taxable": "as salary.gross-to-net",
    "irg": "as salary.gross-to-net",
    "net": "as salary.gross-to-net",
    "cnas_employer": "as salary.gross-to-net"
  },
  "cases": [
    {
      "id": "net-20000",
      "input": {
        "net": 20000,
        "regime": "salaried",
        "date": "2026-10-28"
      },
      "expected": {
        "gross": 21978.02,
        "cnas_employee": 1978.02,
        "taxable": 20000,
        "irg": 0,
        "net": 20000,
        "cnas_employer": 5604.4
      }
    },
    {
